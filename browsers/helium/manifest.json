{
  "manifest_version": 3,
  "name": "Noctalia Start Page",
  "description": "A local New Tab page themed by Noctalia.",
  "version": "1.0.0",
  "permissions": ["search"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/extension-16.png",
    "32": "icons/extension-32.png",
    "48": "icons/extension-48.png",
    "128": "icons/extension-128.png"
  }
}
